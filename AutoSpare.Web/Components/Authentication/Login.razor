@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>ورود به سامانه | AutoSpare</PageTitle>

<div class="login-page-root">
    <div class="login-container">
        <MudPaper Elevation="6" Class="login-card pa-8 rounded-2xl">
            <!-- سربرگ و لوگو -->
            <div class="d-flex flex-column align-center mb-6">
                <div class="brand-avatar-box mb-3">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Class="brand-avatar elevation-4">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Large"/>
                    </MudAvatar>
                </div>
                <MudText Typo="Typo.h5" Class="font-weight-bold text-center brand-title" Color="Color.Primary">
                    AutoSpare
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary text-center mt-1">
                    سامانه هوشمند مدیریت انبار و فروشگاه قطعات یدکی
                </MudText>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-5 rounded-lg" Elevation="1">
                    @ErrorMessage
                </MudAlert>
            }

            <!-- فرم احراز هویت -->
            <form method="post" action="/api/auth/login" class="login-form">
                <!-- فیلد نام کاربری -->
                <div class="mb-5">
                    <MudTextField T="string"
                                  Name="Username"
                                  Label="نام کاربری"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                                  AdornmentColor="Color.Primary"
                                  Required="true"
                                  AutoGrow="false"
                                  AutoFocus="true"
                                  Class="custom-input mud-ltr-input"/>
                </div>

                <!-- فیلد رمز عبور -->
                <div class="mb-3">
                    <MudTextField T="string"
                                  Name="Password"
                                  Label="رمز عبور"
                                  Variant="Variant.Outlined"
                                  InputType="@_passwordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  AdornmentColor="Color.Default"
                                  Required="true"
                                  Class="custom-input mud-ltr-input"/>
                </div>

                <!-- تیک مرا به خاطر بسپار -->
                <div class="d-flex align-center mb-5 mt-2">
                    <input type="hidden" name="RememberMe" value="false"/>
                    <label class="d-flex align-center cursor-pointer remember-me-box">
                        <input type="checkbox" name="RememberMe" value="true" class="remember-checkbox"/>
                        <span class="mud-typography mud-typography-body2 mr-2">مرا به خاطر بسپار</span>
                    </label>
                </div>

                <!-- دکمه ورود -->
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Login"
                           Class="login-btn py-3 rounded-lg font-weight-bold">
                    ورود به سامانه
                </MudButton>
            </form>

            <div class="text-center mt-6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    نسخه 1.0.0 | سیستم مدیریت اختصاصی
                </MudText>
            </div>
        </MudPaper>
    </div>
</div>

<style>
    html, body {
        overflow: hidden !important;
        height: 100% !important;
        margin: 0;
        padding: 0;
    }

    .login-page-root {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        direction: rtl;
        overflow: hidden;
        background-color: var(--mud-palette-background-grey);
    }

    .login-container {
        width: 100%;
        max-width: 490px;
        padding: 1.5rem;
        box-sizing: border-box;
    }

    .login-card {
        background-color: var(--mud-palette-surface) !important;
        border: 1px solid var(--mud-palette-lines-default);
    }

    .brand-avatar-box {
        animation: floatIcon 3s ease-in-out infinite;
    }

    .brand-avatar {
        box-shadow: 0 8px 20px rgba(var(--mud-palette-primary-rgb), 0.35);
    }

    .login-btn {
        text-transform: none;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 14px rgba(var(--mud-palette-primary-rgb), 0.35);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .login-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(var(--mud-palette-primary-rgb), 0.45);
    }

    .custom-input .mud-input-outlined-border {
        border-radius: 10px !important;
    }

    /* پوزیشن‌دهی کانتینر ورودی برای پین کردن قطعی آیکون‌ها */
    .custom-input .mud-input-control-input-container {
        position: relative !important;
    }

    .custom-input input {
        direction: ltr !important;
        text-align: left !important;
        border-radius: 10px !important;
        padding-top: 14px !important;
        padding-bottom: 14px !important;
        padding-left: 48px !important; /* فضا برای اینکه متن روی آیکون نیفتد */
    }

    .custom-input input:-webkit-autofill,
    .custom-input input:-webkit-autofill:hover,
    .custom-input input:-webkit-autofill:focus {
        -webkit-box-shadow: 0 0 0px 1000px var(--mud-palette-surface) inset !important;
        -webkit-text-fill-color: var(--mud-palette-text-primary) !important;
        border-radius: 10px !important;
    }

    /* تراز دقیق هر دو آیکون دقیقا روی یک خط عمودی در سمت چپ کادر */
    .custom-input .mud-input-adornment-end {
        position: absolute !important;
        left: 14px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        width: 32px !important;
        height: 32px !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        z-index: 2 !important;
    }

    .custom-input .mud-input-adornment-end .mud-icon-root {
        font-size: 1.35rem !important;
    }

    .custom-input .mud-input-adornment-end .mud-button-root {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        height: 100% !important;
    }

    .remember-me-box {
        user-select: none;
    }

    .remember-checkbox {
        accent-color: var(--mud-palette-primary);
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    @@keyframes floatIcon {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-5px);
        }
    }
</style>

@code {
    private bool _passwordVisibility;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "InvalidCredentials" => "نام کاربری یا رمز عبور اشتباه است.",
        _ => null
    };

    private void TogglePasswordVisibility()
    {
        if (_passwordVisibility)
        {
            _passwordVisibility = false;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
        }
        else
        {
            _passwordVisibility = true;
            _passwordIcon = Icons.Material.Filled.Visibility;
            _passwordInputType = InputType.Text;
        }
    }
}
