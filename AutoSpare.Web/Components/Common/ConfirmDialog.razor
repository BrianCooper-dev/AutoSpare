@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icon" Color="@Color" Size="Size.Medium" />
            <MudText Typo="Typo.h6">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="my-2">@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">
            انصراف
        </MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Submit" AutoFocus="true">
            @ConfirmButtonText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "تأیید عملیات";

    [Parameter]
    public string ContentText { get; set; } = "آیا از انجام این عملیات اطمینان دارید؟ این عملیات ممکن است غیرقابل بازگشت باشد.";

    [Parameter]
    public string ConfirmButtonText { get; set; } = "تأیید";

    [Parameter]
    public Color Color { get; set; } = Color.Error;

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Warning;

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}
