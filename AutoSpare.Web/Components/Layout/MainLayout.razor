@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_currentTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout RightToLeft="true">
    <MudAppBar Elevation="2" Color="Color.Primary" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@DrawerToggle" />

        <MudText Typo="Typo.h6" Class="mr-3 font-weight-bold">
            سامانه مدیریت قطعات یدکی و انبار | AutoSpare
        </MudText>

        <MudSpacer />

        <MudToggleIconButton Toggled="@_isDarkMode"
                             ToggledChanged="OnDarkModeToggled"
                             Icon="@Icons.Material.Filled.DarkMode"
                             Color="Color.Inherit"
                             ToggledIcon="@Icons.Material.Filled.LightMode"
                             ToggledColor="Color.Warning"
                             Title="تغییر حالت شب/روز" />

        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-center mx-3">
                    <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="ml-2">
                        @GetUserInitial(context.User.Identity?.Name)
                    </MudAvatar>
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        @context.User.Identity?.Name
                    </MudText>
                </div>
            </Authorized>
        </AuthorizeView>

        <form method="post" action="/api/auth/logout" class="d-inline">
            <MudIconButton ButtonType="ButtonType.Submit"
                           Icon="@Icons.Material.Filled.Logout"
                           Color="Color.Inherit"
                           Title="خروج از سامانه" />
        </form>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Anchor="Anchor.Right"
               ClipMode="DrawerClipMode.Always"
               Elevation="3"
               Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-12">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private const string DarkModeKey = "app_dark_mode";

    private bool _drawerOpen = true;
    private bool _isDarkMode;

    private readonly MudTheme _currentTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            Secondary = "#0EA5E9",
            AppbarBackground = "#1E293B",
            AppbarText = "#FFFFFF",
            Surface = "#FFFFFF",
            Background = "#F8FAFC",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#334155",
            TextPrimary = "#0F172A",
            TableHover = "#F1F5F9"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#3B82F6",
            Secondary = "#38BDF8",
            Surface = "#1E293B",
            Background = "#0F172A",
            AppbarBackground = "#0F172A",
            DrawerBackground = "#1E293B",
            DrawerText = "#E2E8F0",
            TextPrimary = "#F8FAFC",
            TableHover = "#334155"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var savedTheme = await JS.InvokeAsync<string>("localStorage.getItem", DarkModeKey);
            if (bool.TryParse(savedTheme, out var isDark) && isDark != _isDarkMode)
            {
                _isDarkMode = isDark;
                StateHasChanged();
            }
        }
        catch (InvalidOperationException)
        {
            // در prerender جاوااسکریپت در دسترس نیست
        }
    }

    private async Task OnDarkModeToggled(bool value)
    {
        _isDarkMode = value;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", DarkModeKey, value.ToString().ToLowerInvariant());
        }
        catch (InvalidOperationException)
        {
        }
    }

    private static string GetUserInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        return char.ToUpperInvariant(name.Trim()[0]).ToString();
    }
}
