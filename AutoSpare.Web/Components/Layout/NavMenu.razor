<MudNavMenu>
    <!-- هدر منو با آیکون قطعات/سیستم -->
    <div class="pa-4 d-flex flex-column align-center">
        <MudAvatar Color="Color.Primary" Size="Size.Large" Elevation="4">
            <MudIcon Icon="@Icons.Material.Filled.BuildCircle" Size="Size.Large" />
        </MudAvatar>
        <MudText Typo="Typo.subtitle1" Class="mt-2 font-weight-bold">پنل مدیریت AutoSpare</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">مدیریت موجودی و فروشگاه</MudText>
    </div>

    <MudDivider Class="mb-3" />

    <!-- داشبورد اصلی -->
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        داشبورد اصلی
    </MudNavLink>

    <!-- مدیریت کالاها و قطعات -->
    <MudNavGroup Title="کالاها و انبارداری" Icon="@Icons.Material.Filled.Inventory2" Expanded="true">
        <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">
            فهرست کالاها
        </MudNavLink>
        <MudNavLink Href="/products/create" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AddBox">
            تعریف قطعه جدید
        </MudNavLink>
        <MudNavLink Href="/inventory/transactions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SwapHoriz">
            کاردکس و تراکنش انبار
        </MudNavLink>
    </MudNavGroup>

    <!-- فاکتورها و فروش -->
    <MudNavGroup Title="فروش و فاکتورها" Icon="@Icons.Material.Filled.PointOfSale" Expanded="false">
        <MudNavLink Href="/sales" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
            فاکتورهای فروش
        </MudNavLink>
        <MudNavLink Href="/sales/new" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AddShoppingCart">
            صدور فاکتور جدید
        </MudNavLink>
    </MudNavGroup>

    <!-- تأمین‌کنندگان و خرید -->
    <MudNavGroup Title="تأمین‌کنندگان و خرید" Icon="@Icons.Material.Filled.LocalShipping" Expanded="false">
        <MudNavLink Href="/suppliers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Store">
            فهرست تأمین‌کنندگان
        </MudNavLink>
        <MudNavLink Href="/purchases" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingBag">
            فاکتورهای خرید
        </MudNavLink>
    </MudNavGroup>

    <!-- طرف‌های حساب و مشتریان -->
    <MudNavGroup Title="مشتریان و همکاران" Icon="@Icons.Material.Filled.People" Expanded="false">
        <MudNavLink Href="/customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Group">
            لیست مشتریان
        </MudNavLink>
        <MudNavLink Href="/customers/create" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAdd">
            ثبت مشتری جدید
        </MudNavLink>
    </MudNavGroup>

    <!-- مالی و تسویه‌ها -->
    <MudNavGroup Title="حسابداری و گزارشات" Icon="@Icons.Material.Filled.AccountBalanceWallet" Expanded="false">
        <MudNavLink Href="/settlements" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PriceCheck">
            تسویه‌های روزانه
        </MudNavLink>
        <MudNavLink Href="/reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">
            گزارش سود و زیان
        </MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-2" />

    <!-- تنظیمات سیستم -->
    <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
        تنظیمات سامانه
    </MudNavLink>
</MudNavMenu>
