@page "/categories"
@rendermode InteractiveServer
@attribute [Authorize]

@using AutoSpare.Application.Categories
@using AutoSpare.Application.Categories.DTOs
@using AutoSpare.Application.Common.RightAligned
@using AutoSpare.Web.Components.Common
@using MudBlazor

@inject ICategoryService CategoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>مدیریت دسته‌بندی‌ها - اتواسپیر</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <MudCard Elevation="2" Class="pa-4">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">مدیریت دسته‌بندی‌ها</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">ایجاد، ویرایش، جستجو و فعال/غیرفعال‌سازی دسته‌بندی کالاها</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialog">
                        دسته‌بندی جدید
                    </MudButton>
                </div>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <!-- بخش فیلترها و جستجو -->
            <div class="d-flex flex-wrap gap-4 align-center mb-4">
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              Placeholder="جستجو در نام یا توضیحات..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true"
                              OnClearButtonClick="ReloadData"
                              Immediate="false"
                              DebounceInterval="400"
                              OnDebounceIntervalElapsed="ReloadData"
                              Class="flex-grow-1" />

                <MudSelect T="int"
                           Value="_selectedStatusFilter"
                           ValueChanged="OnStatusFilterChanged"
                           Label="وضعیت"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width: 170px;">
                    <MudSelectItem Value="0">همه وضعیت‌ها</MudSelectItem>
                    <MudSelectItem Value="1">فقط فعال‌ها</MudSelectItem>
                    <MudSelectItem Value="2">فقط غیرفعال‌ها</MudSelectItem>
                </MudSelect>

                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Default"
                               OnClick="ReloadData"
                               Title="بارگذاری مجدد" />
            </div>

            <!-- جدول دسته‌بندی‌ها -->
            <MudTable Items="@_categories"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Striped="true"
                      Loading="@_loading"
                      LoadingProgressColor="Color.Primary"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>نام دسته‌بندی</MudTh>
                    <MudTh>توضیحات</MudTh>
                    <MudTh Style="text-align: center;">تعداد کالاها</MudTh>
                    <MudTh Style="text-align: center;">وضعیت</MudTh>
                    <MudTh Style="text-align: center;">تاریخ ایجاد</MudTh>
                    <MudTh Style="text-align: center;">عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="نام دسته‌بندی">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="توضیحات">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @(string.IsNullOrWhiteSpace(context.Description) ? "—" : context.Description)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="تعداد کالاها" Style="text-align: center;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                            @context.ProductsCount.ToString("N0")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="وضعیت" Style="text-align: center;">
                        @if (context.IsActive)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">فعال</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">غیرفعال</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="تاریخ ایجاد" Style="text-align: center;">
                        <MudText Typo="Typo.caption">
                            @context.CreatedAt.ToPersianDate()
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="عملیات" Style="text-align: center;">
                        <div class="d-flex justify-center gap-1">
                            <MudTooltip Text="ویرایش دسته‌بندی">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => OpenEditDialog(context))" />
                            </MudTooltip>

                            <MudTooltip Text="@(context.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")">
                                <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircleOutline)"
                                               Size="Size.Small"
                                               Color="@(context.IsActive ? Color.Warning : Color.Success)"
                                               OnClick="@(() => ToggleCategoryStatus(context))" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-6 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" Class="mud-text-secondary mb-2" />
                        <MudText Typo="Typo.body1" Class="mud-text-secondary">هیچ دسته‌بندی‌ای یافت نشد.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<CategoryDto> _categories = new();
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private int _selectedStatusFilter = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        _loading = true;
        try
        {
            bool? activeFilter = _selectedStatusFilter switch
            {
                1 => true,
                2 => false,
                _ => null
            };

            _categories = await CategoryService.GetAllAsync(_searchTerm, activeFilter);
        }
        catch (Exception ex)
        {
            Snackbar.ShowError($"خطا در بارگذاری اطلاعات: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadData()
    {
        await LoadCategoriesAsync();
    }

    private async Task OnStatusFilterChanged(int value)
    {
        _selectedStatusFilter = value;
        await LoadCategoriesAsync();
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CategoryDialog>("افزودن دسته‌بندی", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CategoryDialog.CategoryFormModel model)
        {
            var createModel = new CreateCategoryModel
            {
                Name = model.Name,
                Description = model.Description
            };

            var (success, error, _) = await CategoryService.CreateAsync(createModel);
            if (success)
            {
                Snackbar.ShowSuccess("دسته‌بندی با موفقیت ایجاد شد.");
                await LoadCategoriesAsync();
            }
            else
            {
                Snackbar.ShowError(error ?? "خطا در ثبت اطلاعات.");
            }
        }
    }

    private async Task OpenEditDialog(CategoryDto category)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.ExistingCategory, category }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CategoryDialog>("ویرایش دسته‌بندی", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CategoryDialog.CategoryFormModel model)
        {
            var updateModel = new UpdateCategoryModel
            {
                Id = model.Id,
                Name = model.Name,
                Description = model.Description
            };

            var (success, error) = await CategoryService.UpdateAsync(updateModel);
            if (success)
            {
                Snackbar.ShowSuccess("دسته‌بندی با موفقیت ویرایش شد.");
                await LoadCategoriesAsync();
            }
            else
            {
                Snackbar.ShowError(error ?? "خطا در ویرایش اطلاعات.");
            }
        }
    }

    private async Task ToggleCategoryStatus(CategoryDto category)
    {
        var actionText = category.IsActive ? "غیرفعال" : "فعال";

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, $"{actionText} کردن دسته‌بندی" },
            { x => x.ContentText, $"آیا از {actionText} کردن دسته‌بندی «{category.Name}» اطمینان دارید؟" },
            { x => x.ConfirmButtonText, $"بله، {actionText} شود" },
            { x => x.Color, category.IsActive ? Color.Warning : Color.Success },
            { x => x.Icon, category.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle }
        };

        var options = new DialogOptions
        {
            CloseButton = false,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("تأیید عملیات", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            var (success, error) = await CategoryService.ToggleStatusAsync(category.Id);
            if (success)
            {
                Snackbar.ShowSuccess($"دسته‌بندی با موفقیت {actionText} شد.");
                await LoadCategoriesAsync();
            }
            else
            {
                Snackbar.ShowError(error ?? $"خطا در {actionText} کردن دسته‌بندی.");
            }
        }
    }
}
