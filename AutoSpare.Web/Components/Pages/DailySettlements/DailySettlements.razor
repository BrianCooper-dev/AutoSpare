@page "/daily-settlements"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Globalization
@using AutoSpare.Application.DailySettlements
@using AutoSpare.Application.DailySettlements.DTOs

@inject IDailySettlementService SettlementService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>تسویه‌های روزانه و گزارشات صندوق | AutoSpare</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8" Dir="rtl">
    <MudBreadcrumbs Items="_breadcrumbItems" Class="pa-0 mb-4"/>

    <MudText Typo="Typo.h5" Class="fw-bold mb-4">
        <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Color="Color.Primary" Class="ms-2"/>
        مدیریت تسویه‌های روزانه و گزارشات صندوق
    </MudText>

    <MudGrid Spacing="4">
        <!-- ستون سمت راست: فرم ثبت / ویرایش تسویه -->
        <MudItem xs="12" lg="5">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex justify-space-between align-center">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold text-primary">
                                    @(isClosedDate ? "مشاهده تسویه نهایی‌شده" : (isEditing ? "ویرایش تسویه روز" : "ثبت تسویه روزانه جدید"))
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    مقادیر دریافتی صندوق را به تفکیک وارد کنید.
                                </MudText>
                            </div>
                            @if (isClosedDate)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                    بسته شده
                                </MudChip>
                            }
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    @if (isClosedDate)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-3">
                            این تسویه نهایی (بسته) شده و قابل ویرایش نیست.
                        </MudAlert>
                    }

                    <MudForm @ref="form" @bind-IsValid="@success">
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudDatePicker Label="تاریخ تسویه *"
                                               Date="model.SettlementDate"
                                               DateChanged="OnDateChanged"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Required="true"
                                               RequiredError="تاریخ تسویه الزامی است"
                                               Disabled="isEditing"/>

                                <MudText Typo="Typo.caption"
                                         Color="Color.Primary"
                                         Class="mt-1 d-block">
                                    روز هفته: <b>@SelectedDayOfWeekTitle</b>
                                </MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal"
                                                 @bind-Value="model.Pos1Amount"
                                                 Label="کارت‌خوان ۱ (تومان)"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="0"
                                                 Format="N0"
                                                 Disabled="isClosedDate"/>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal"
                                                 @bind-Value="model.Pos2Amount"
                                                 Label="کارت‌خوان ۲ (تومان)"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="0"
                                                 Format="N0"
                                                 Disabled="isClosedDate"/>
                            </MudItem>

                            <MudItem xs="12">
                                <MudNumericField T="decimal"
                                                 @bind-Value="model.CashAmount"
                                                 Label="مبلغ نقدی (تومان)"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="0"
                                                 Format="N0"
                                                 Disabled="isClosedDate"/>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="model.Notes"
                                              Label="توضیحات و مغایرت‌ها"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Lines="2"
                                              Disabled="isClosedDate"/>
                            </MudItem>

                            <!-- خلاصه محاسبات -->
                            <MudItem xs="12">
                                <MudPaper Elevation="0"
                                          Outlined="true"
                                          Class="pa-3 rounded-lg mud-theme-background-gray">

                                    <div class="d-flex justify-space-between mb-1">
                                        <MudText Typo="Typo.body2">جمع کل تسویه دستی:</MudText>
                                        <MudText Typo="Typo.body2" Class="fw-bold text-success">
                                            @TotalCalculatedAmount.ToString("N0") تومان
                                        </MudText>
                                    </div>

                                    <div class="d-flex justify-space-between mb-1">
                                        <MudText Typo="Typo.body2">فروش سیستم در این روز:</MudText>
                                        <MudText Typo="Typo.body2" Class="fw-bold">
                                            @currentSystemSales.ToString("N0") تومان
                                        </MudText>
                                    </div>

                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2">مغایرت صندوق:</MudText>
                                        <MudText Typo="Typo.body2"
                                                 Class="fw-bold"
                                                 Color="@GetDiscrepancyColor(FormDiscrepancy)">
                                            @FormDiscrepancy.ToString("N0") تومان
                                            (@GetDiscrepancyTitle(FormDiscrepancy))
                                        </MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <div class="d-flex gap-2 mt-4">
                            @if (!isClosedDate)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Disabled="@(!success || isSaving)"
                                           OnClick="SaveAsync">
                                    @(isSaving ? "در حال ذخیره..." : (isEditing ? "به‌روزرسانی تسویه" : "ثبت تسویه روز"))
                                </MudButton>
                            }

                            @if (isEditing)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           OnClick="CancelEditAsync">
                                    انصراف
                                </MudButton>
                            }
                        </div>
                    </MudForm>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- ستون سمت چپ: تاریخچه و گزارشات -->
        <MudItem xs="12" lg="7">
            <MudTabs Elevation="3"
                     Rounded="true"
                     ApplyEffectsToContainer="true"
                     PanelClass="pa-4">

                <!-- تب تاریخچه تسویه‌ها -->
                <MudTabPanel Text="تاریخچه تسویه‌ها" Icon="@Icons.Material.Filled.History">
                    <MudTable Items="settlements"
                              Dense="true"
                              Hover="true"
                              Striped="true"
                              Elevation="0"
                              Breakpoint="Breakpoint.Sm"
                              Class="mt-2">

                        <HeaderContent>
                            <MudTh>تاریخ تسویه</MudTh>
                            <MudTh>کارت‌خوان ۱</MudTh>
                            <MudTh>کارت‌خوان ۲</MudTh>
                            <MudTh>نقد</MudTh>
                            <MudTh>جمع کل</MudTh>
                            <MudTh>وضعیت</MudTh>
                            <MudTh Style="text-align: center;">عملیات</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd DataLabel="تاریخ تسویه">
                                <b>@context.PersianDateString</b>
                                <div class="mud-text-secondary" style="font-size: 0.75rem;">
                                    @context.DayOfWeekTitle
                                </div>
                            </MudTd>

                            <MudTd DataLabel="کارت‌خوان ۱">@context.Pos1Amount.ToString("N0")</MudTd>
                            <MudTd DataLabel="کارت‌خوان ۲">@context.Pos2Amount.ToString("N0")</MudTd>
                            <MudTd DataLabel="نقد">@context.CashAmount.ToString("N0")</MudTd>
                            <MudTd DataLabel="جمع کل"><b>@context.TotalAmount.ToString("N0")</b></MudTd>

                            <MudTd DataLabel="وضعیت">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(context.Status == 1 ? Color.Info : Color.Success)"
                                         Variant="Variant.Text">
                                    @context.StatusTitle
                                </MudChip>
                            </MudTd>

                            <MudTd DataLabel="عملیات" Style="text-align: center;">
                                <div class="d-flex justify-center gap-1">
                                    @if (context.Status == 1)
                                    {
                                        <MudTooltip Text="ویرایش">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => Edit(context))"/>
                                        </MudTooltip>

                                        <MudTooltip Text="بستن و نهایی‌سازی">
                                            <MudIconButton Icon="@Icons.Material.Filled.Lock"
                                                           Color="Color.Success"
                                                           Size="Size.Small"
                                                           OnClick="@(() => CloseSettlement(context.Id))"/>
                                        </MudTooltip>
                                    }

                                    <MudTooltip Text="حذف و بازنشانی روز">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeleteSettlementAsync(context))"/>
                                    </MudTooltip>
                                </div>
                            </MudTd>
                        </RowTemplate>

                        <NoRecordsContent>
                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary"
                                     Class="pa-4 text-center">
                                هیچ تسویه‌ای ثبت نشده است.
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>

                <!-- تب گزارش تفکیکی ماهانه و سالانه -->
                <MudTabPanel Text="گزارش تفکیکی ماهانه و سالانه"
                             Icon="@Icons.Material.Filled.Assessment">

                    <div class="d-flex flex-column gap-4 mt-2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                            گزارش عملکرد صندوق به تفکیک کارت‌خوان ۱، کارت‌خوان ۲ و نقدی:
                        </MudText>

                        @if (monthlyReports.Count == 0)
                        {
                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary"
                                     Class="text-center py-4">
                                داده‌ای برای گزارش‌گیری موجود نیست.
                            </MudText>
                        }
                        else
                        {
                            <MudTable Items="monthlyReports"
                                      Dense="true"
                                      Hover="true"
                                      Striped="true"
                                      Elevation="0">

                                <HeaderContent>
                                    <MudTh>ماه / سال شمسی</MudTh>
                                    <MudTh>کارت‌خوان ۱</MudTh>
                                    <MudTh>کارت‌خوان ۲</MudTh>
                                    <MudTh>نقدی</MudTh>
                                    <MudTh>جمع کل ماه</MudTh>
                                </HeaderContent>

                                <RowTemplate>
                                    <MudTd><b>@context.MonthTitle</b></MudTd>
                                    <MudTd>@context.Pos1Total.ToString("N0")</MudTd>
                                    <MudTd>@context.Pos2Total.ToString("N0")</MudTd>
                                    <MudTd>@context.CashTotal.ToString("N0")</MudTd>
                                    <MudTd>
                                        <b class="text-success">
                                            @context.GrandTotal.ToString("N0") تومان
                                        </b>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>

                            <MudPaper Elevation="0"
                                      Outlined="true"
                                      Class="pa-3 rounded-lg mud-theme-background-gray mt-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">
                                    مجموع عملکرد سالانه:
                                </MudText>

                                <div class="d-flex justify-space-between flex-wrap gap-2">
                                    <MudText Typo="Typo.body2">
                                        کارت‌خوان ۱: <b>@YearlyPos1Total.ToString("N0")</b>
                                    </MudText>

                                    <MudText Typo="Typo.body2">
                                        کارت‌خوان ۲: <b>@YearlyPos2Total.ToString("N0")</b>
                                    </MudText>

                                    <MudText Typo="Typo.body2">
                                        نقدی: <b>@YearlyCashTotal.ToString("N0")</b>
                                    </MudText>

                                    <MudText Typo="Typo.body1" Color="Color.Primary">
                                        کل: <b>@YearlyGrandTotal.ToString("N0") تومان</b>
                                    </MudText>
                                </div>
                            </MudPaper>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private MudForm form = default!;
    private bool success;
    private readonly PersianCalendar _persianCalendar = new();

    private UpsertDailySettlementDto model = new()
    {
        SettlementDate = DateTime.Today
    };

    private List<DailySettlementDto> settlements = new();
    private List<MonthlySettlementReportDto> monthlyReports = new();

    private bool isEditing;
    private bool isSaving;
    private bool isClosedDate;
    private decimal currentSystemSales;

    private decimal TotalCalculatedAmount =>
        model.Pos1Amount + model.Pos2Amount + model.CashAmount;

    private decimal FormDiscrepancy =>
        TotalCalculatedAmount - currentSystemSales;

    private decimal YearlyPos1Total =>
        monthlyReports.Sum(x => x.Pos1Total);

    private decimal YearlyPos2Total =>
        monthlyReports.Sum(x => x.Pos2Total);

    private decimal YearlyCashTotal =>
        monthlyReports.Sum(x => x.CashTotal);

    private decimal YearlyGrandTotal =>
        monthlyReports.Sum(x => x.GrandTotal);

    private string SelectedDayOfWeekTitle =>
        (model.SettlementDate ?? DateTime.Today).DayOfWeek switch
        {
            DayOfWeek.Saturday => "شنبه",
            DayOfWeek.Sunday => "یکشنبه",
            DayOfWeek.Monday => "دوشنبه",
            DayOfWeek.Tuesday => "سه‌شنبه",
            DayOfWeek.Wednesday => "چهارشنبه",
            DayOfWeek.Thursday => "پنج‌شنبه",
            DayOfWeek.Friday => "جمعه",
            _ => string.Empty
        };

    private readonly List<BreadcrumbItem> _breadcrumbItems =
    [
        new BreadcrumbItem("داشبورد", href: "/"),
        new BreadcrumbItem("تسویه‌های روزانه", href: null, disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await SyncFormWithSelectedDateAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            settlements = await SettlementService.GetAllAsync();
            CalculateMonthlyReports();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری تسویه‌ها: {ex.Message}", Severity.Error);
        }
    }

    private void CalculateMonthlyReports()
    {
        monthlyReports = settlements
            .GroupBy(s => new
            {
                Year = _persianCalendar.GetYear(s.SettlementDate),
                Month = _persianCalendar.GetMonth(s.SettlementDate)
            })
            .Select(g => new MonthlySettlementReportDto
            {
                Year = g.Key.Year,
                Month = g.Key.Month,
                MonthTitle = $"{g.Key.Year:0000}/{g.Key.Month:00}",
                Pos1Total = g.Sum(x => x.Pos1Amount),
                Pos2Total = g.Sum(x => x.Pos2Amount),
                CashTotal = g.Sum(x => x.CashAmount),
                GrandTotal = g.Sum(x => x.TotalAmount)
            })
            .OrderByDescending(x => x.Year)
            .ThenByDescending(x => x.Month)
            .ToList();
    }

    private async Task OnDateChanged(DateTime? newDate)
    {
        if (!newDate.HasValue)
            return;

        model.SettlementDate = newDate.Value;
        await SyncFormWithSelectedDateAsync();
    }

    private async Task SyncFormWithSelectedDateAsync()
    {
        try
        {
            var targetDate = model.SettlementDate ?? DateTime.Today;
            currentSystemSales =
                await SettlementService.GetSystemSalesTotalAsync(targetDate);

            var existing = settlements.FirstOrDefault(s =>
                s.SettlementDate.Date == targetDate.Date);

            if (existing is not null)
            {
                if (existing.Status == 2)
                {
                    isClosedDate = true;
                    isEditing = false;
                    model.Id = existing.Id;
                    model.Pos1Amount = existing.Pos1Amount;
                    model.Pos2Amount = existing.Pos2Amount;
                    model.CashAmount = existing.CashAmount;
                    model.Notes = existing.Notes;
                }
                else
                {
                    isClosedDate = false;
                    Edit(existing);
                }
            }
            else
            {
                isClosedDate = false;
                if (!isEditing)
                {
                    model.Id = null;
                    model.Pos1Amount = 0;
                    model.Pos2Amount = 0;
                    model.CashAmount = 0;
                    model.Notes = string.Empty;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"خطا در همگام‌سازی تاریخ: {ex.Message}",
                Severity.Warning);
        }
    }

    private Color GetDiscrepancyColor(decimal discrepancy) => discrepancy switch
    {
        0 => Color.Success,
        < 0 => Color.Error,
        > 0 => Color.Info
    };

    private string GetDiscrepancyTitle(decimal discrepancy) => discrepancy switch
    {
        0 => "تراز (۰)",
        < 0 => $"{discrepancy:N0} (کسری)",
        > 0 => $"+{discrepancy:N0} (اضافه)"
    };

    private async Task SaveAsync()
    {
        if (isSaving || isClosedDate)
            return;

        await form.Validate();
        if (!form.IsValid)
            return;

        try
        {
            isSaving = true;

            await SettlementService.UpsertAsync(model);

            Snackbar.Add(
                "تسویه روزانه با موفقیت ثبت شد.",
                Severity.Success);

            isEditing = false;
            await LoadDataAsync();
            await SyncFormWithSelectedDateAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"خطا در ذخیره تسویه: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Edit(DailySettlementDto dto)
    {
        isEditing = true;
        isClosedDate = dto.Status == 2;

        model = new UpsertDailySettlementDto
        {
            Id = dto.Id,
            SettlementDate = dto.SettlementDate,
            Pos1Amount = dto.Pos1Amount,
            Pos2Amount = dto.Pos2Amount,
            CashAmount = dto.CashAmount,
            Notes = dto.Notes
        };

        currentSystemSales = dto.SystemSalesAmount;
    }

    private async Task CancelEditAsync()
    {
        isEditing = false;
        isClosedDate = false;
        model = new UpsertDailySettlementDto
        {
            SettlementDate = DateTime.Today
        };

        await SyncFormWithSelectedDateAsync();
    }

    private async Task DeleteSettlementAsync(DailySettlementDto dto)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "تأیید حذف و بازنشانی" },
            {
                x => x.ContentText,
                $"آیا از حذف و بازنشانی تسویه روز {dto.PersianDateString} اطمینان دارید؟ تمام مبالغ این روز پاک خواهند شد."
            },
            { x => x.ConfirmButtonText, "بله، حذف و بازنشانی شود" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "تأیید حذف",
            parameters);

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        try
        {
            await SettlementService.DeleteAsync(dto.Id);

            Snackbar.Add(
                "تسویه روزانه با موفقیت حذف شد.",
                Severity.Success);

            await LoadDataAsync();
            await SyncFormWithSelectedDateAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"خطا در حذف تسویه: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task CloseSettlement(Guid id)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "نهایی‌سازی و بستن تسویه" },
            {
                x => x.ContentText,
                "آیا از نهایی‌سازی و بستن این تسویه مطمئن هستید؟ پس از بستن، امکان ویرایش وجود نخواهد داشت."
            },
            { x => x.ConfirmButtonText, "بله، نهایی شود" },
            { x => x.Color, Color.Success }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "تأیید نهایی‌سازی",
            parameters);

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        try
        {
            await SettlementService.CloseAsync(id);

            Snackbar.Add(
                "تسویه روزانه با موفقیت نهایی و قفل شد.",
                Severity.Success);

            await LoadDataAsync();
            await SyncFormWithSelectedDateAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"خطا در بستن تسویه: {ex.Message}",
                Severity.Error);
        }
    }

    public class MonthlySettlementReportDto
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public string MonthTitle { get; set; } = string.Empty;
        public decimal Pos1Total { get; set; }
        public decimal Pos2Total { get; set; }
        public decimal CashTotal { get; set; }
        public decimal GrandTotal { get; set; }
    }

}
