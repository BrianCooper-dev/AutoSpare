@page "/"

@using AutoSpare.Application.Products
@using AutoSpare.Application.Products.DTOs
@using AutoSpare.Application.Reports
@using AutoSpare.Application.Reports.DTOs
@using AutoSpare.Application.Reports.Enums
@inject IReportService ReportService
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>داشبورد مدیریت | AutoSpare</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <!-- هدر خوش‌آمدگویی و سوئیچ نمای کلی / نمودار تخصصی -->
    <MudPaper Elevation="2" Class="pa-5 mb-5 rounded-lg d-flex justify-space-between align-center flex-wrap gap-4"
              Color="Color.Primary">
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold">پنل مدیریت یکپارچه AutoSpare</MudText>
            <MudText Typo="Typo.body2" Class="mt-1" Style="opacity: 0.9;">
                خلاصه شاخص‌های فروش، سودآوری، سرمایه در انبار و هشدارهای فوری
            </MudText>
        </div>
        <div class="d-flex align-center gap-3 flex-wrap">
            <!-- دکمه جابجایی بین نمای کارت‌ها و تحلیل نمودار -->
            <MudButtonGroup Color="Color.Surface" Variant="Variant.Filled" Size="Size.Medium">
                <MudButton Variant="@(_viewMode == DashboardViewMode.CardsOnly ? Variant.Filled : Variant.Outlined)"
                           Color="@(_viewMode == DashboardViewMode.CardsOnly ? Color.Inherit : Color.Primary)"
                           StartIcon="@Icons.Material.Filled.Dashboard"
                           OnClick="@(() => SetViewModeAsync(DashboardViewMode.CardsOnly))">
                    نمای کلی و آمار
                </MudButton>
                <MudButton Variant="@(_viewMode == DashboardViewMode.ChartOnly ? Variant.Filled : Variant.Outlined)"
                           Color="@(_viewMode == DashboardViewMode.ChartOnly ? Color.Inherit : Color.Primary)"
                           StartIcon="@Icons.Material.Filled.ShowChart"
                           OnClick="@(() => SetViewModeAsync(DashboardViewMode.ChartOnly))">
                    تحلیل فروش و سود
                </MudButton>
            </MudButtonGroup>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.NotificationsActive"
                       OnClick="@(() => NavigationManager.NavigateTo("/inventory/alerts"))">
                هشدارهای انبار (@_totalAlertsCount)
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Inherit"
                           OnClick="LoadDashboardDataAsync"
                           Title="بروزرسانی داده‌ها"/>
        </div>
    </MudPaper>

    @if (_viewMode == DashboardViewMode.CardsOnly)
    {
        <!-- کارت‌های آماری ردیف اول: مالی و فروش -->
        <MudGrid Class="mb-4">
            <!-- فروش امروز -->
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="dashboard-card rounded-lg">
                    <MudCardContent Class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">فروش امروز
                            </MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold mt-1 text-primary">
                                @_summary.TodaySalesAmount.ToString("N0") <span style="font-size: 0.75rem;">تومان</span>
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_summary.TodayCompletedSalesCount فاکتور نهایی‌شده
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Size="Size.Large" Elevation="2">
                            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Size="Size.Medium"/>
                        </MudAvatar>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- سود ناخالص امروز -->
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="dashboard-card rounded-lg">
                    <MudCardContent Class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">سود محقق‌شده
                                امروز
                            </MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold mt-1 text-success">
                                @_summary.TodayProfitAmount.ToString("N0") <span
                                    style="font-size: 0.75rem;">تومان</span>
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                اختلاف فروش و بهای خرید
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Size="Size.Large" Elevation="2">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Medium"/>
                        </MudAvatar>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- فروش ماه جاری -->
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="dashboard-card rounded-lg">
                    <MudCardContent Class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">فروش کل ماه
                            </MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold mt-1 text-info">
                                @_summary.MonthSalesAmount.ToString("N0") <span style="font-size: 0.75rem;">تومان</span>
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                سود: @_summary.MonthProfitAmount.ToString("N0")
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Info" Size="Size.Large" Elevation="2">
                            <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Medium"/>
                        </MudAvatar>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- ارزش سرمایه در انبار -->
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="dashboard-card rounded-lg">
                    <MudCardContent Class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">ارزش خرید
                                انبار
                            </MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold mt-1 text-secondary">
                                @_summary.TotalInventoryPurchaseValue.ToString("N0") <span
                                    style="font-size: 0.75rem;">تومان</span>
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                موجودی کل: @_summary.TotalStockItemsCount قلم
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Dark" Size="Size.Large" Elevation="2">
                            <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Medium"/>
                        </MudAvatar>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- کارت‌های آماری ردیف دوم: هشدارهای انبار و دسترسی سریع -->
        <MudGrid Class="mb-5">
            <!-- هشدارهای کم‌موجودی -->
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="dashboard-card rounded-lg cursor-pointer"
                         @onclick="@(() => NavigationManager.NavigateTo("/inventory/alerts"))">
                    <MudCardContent Class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">هشدارهای فعال
                                انبار
                            </MudText>
                            <MudText Typo="Typo.h5" Class="font-weight-bold mt-1"
                                     Color="@(_totalAlertsCount > 0 ? Color.Warning : Color.Success)">
                                @_totalAlertsCount
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(_totalAlertsCount > 0 ? "نیازمند بررسی و تأمین فوری" : "همه موجودی‌ها نرمال است")
                            </MudText>
                        </div>
                        <MudAvatar Color="@(_totalAlertsCount > 0 ? Color.Warning : Color.Success)" Size="Size.Medium"
                                   Elevation="2">
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small"/>
                        </MudAvatar>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- موجودی صفر -->
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="dashboard-card rounded-lg cursor-pointer"
                         @onclick="@(() => NavigationManager.NavigateTo("/inventory/alerts"))">
                    <MudCardContent Class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">اقلام بدون
                                موجودی
                                (صفر)
                            </MudText>
                            <MudText Typo="Typo.h5" Class="font-weight-bold mt-1"
                                     Color="@(_outOfStockCount > 0 ? Color.Error : Color.Success)">
                                @_outOfStockCount
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                توقف فروش به دلیل کسری کامل
                            </MudText>
                        </div>
                        <MudAvatar Color="@(_outOfStockCount > 0 ? Color.Error : Color.Success)" Size="Size.Medium"
                                   Elevation="2">
                            <MudIcon Icon="@Icons.Material.Filled.ProductionQuantityLimits" Size="Size.Small"/>
                        </MudAvatar>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- ثبت فاکتور جدید سریع -->
            <MudItem xs="12" sm="12" md="4">
                <MudCard Elevation="2" Class="dashboard-card rounded-lg d-flex align-center px-4 py-2">
                    <div class="d-flex gap-2 w-100 pt-4">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                   OnClick="@(() => NavigationManager.NavigateTo("/purchases/create"))">
                            فاکتور خرید
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.ReceiptLong"
                                   OnClick="@(() => NavigationManager.NavigateTo("/sales/create"))">
                            فاکتور فروش
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <!-- بخش نمودار روند فروش و سود (فقط در حالت تحلیل و نمودار پیشرفته) -->
        <MudGrid Class="mb-5">
            <MudItem xs="12">
                <MudCard Elevation="3" Class="rounded-lg pa-2">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Info" Size="Size.Large" Elevation="2">
                                <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Medium"/>
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">تحلیل مقایسه‌ای روند فروش و سود</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @(_chartFromDate.HasValue || _chartToDate.HasValue
                                    ? "فیلتر سفارشی بازه تاریخ اعمال شده است (ارقام بر حسب میلیون تومان)"
                                    : (_chartPeriod == ChartPeriodMode.Daily ? "روند روزانه ۳۰ روز گذشته (میلیون تومان)" : "روند تجمیعی ماهانه سال جاری (میلیون تومان)"))
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <!-- انتخاب نوع شاخص نمایش (فروش، سود، یا هر دو) -->
                                <MudButtonGroup Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudButton
                                        Variant="@(_metricMode == ChartMetricMode.Both ? Variant.Filled : Variant.Outlined)"
                                        OnClick="@(() => ChangeMetricModeAsync(ChartMetricMode.Both))">
                                        هر دو
                                    </MudButton>
                                    <MudButton
                                        Variant="@(_metricMode == ChartMetricMode.SalesOnly ? Variant.Filled : Variant.Outlined)"
                                        OnClick="@(() => ChangeMetricModeAsync(ChartMetricMode.SalesOnly))">
                                        فقط فروش
                                    </MudButton>
                                    <MudButton
                                        Variant="@(_metricMode == ChartMetricMode.ProfitOnly ? Variant.Filled : Variant.Outlined)"
                                        OnClick="@(() => ChangeMetricModeAsync(ChartMetricMode.ProfitOnly))">
                                        فقط سود
                                    </MudButton>
                                </MudButtonGroup>

                                <!-- بازه پیش‌فرض: روزانه / ماهانه -->
                                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudButton
                                        Variant="@(_chartPeriod == ChartPeriodMode.Daily && !_isCustomDateFilter ? Variant.Filled : Variant.Outlined)"
                                        OnClick="@(() => ChangePeriodModeAsync(ChartPeriodMode.Daily))">
                                        روزانه (۳۰ روز)
                                    </MudButton>
                                    <MudButton
                                        Variant="@(_chartPeriod == ChartPeriodMode.Monthly && !_isCustomDateFilter ? Variant.Filled : Variant.Outlined)"
                                        OnClick="@(() => ChangePeriodModeAsync(ChartPeriodMode.Monthly))">
                                        ماهانه (امسال)
                                    </MudButton>
                                </MudButtonGroup>
                            </div>
                        </CardHeaderActions>
                    </MudCardHeader>

                    <!-- نوار فیلتر بازه تاریخ سفارشی برای نمودار -->
                    <MudPaper Elevation="0"
                              Class="pa-3 mx-4 mb-2 rounded bg-light border d-flex align-center gap-3 flex-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Primary" Size="Size.Small"/>
                        <MudText Typo="Typo.body2" Class="font-weight-bold">فیلتر بازه تاریخ:</MudText>

                        <div style="width: 170px;">
                            <MudDatePicker Label="از تاریخ"
                                           @bind-Date="_chartFromDate"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           DateFormat="yyyy/MM/dd"/>
                        </div>
                        <div style="width: 170px;">
                            <MudDatePicker Label="تا تاریخ"
                                           @bind-Date="_chartToDate"
                                           Margin="Margin.Dense"
                                           Clearable="true"
                                           DateFormat="yyyy/MM/dd"/>
                        </div>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.FilterAlt"
                                   OnClick="ApplyChartDateFilterAsync">
                            اعمال فیلتر
                        </MudButton>

                        @if (_isCustomDateFilter)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Clear"
                                       OnClick="ResetChartDateFilterAsync">
                                حذف فیلتر بازه
                            </MudButton>
                        }
                    </MudPaper>

                    <MudCardContent>
                        @if (_isLoadingChart)
                        {
                            <div class="d-flex justify-center align-center py-12">
                                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large"/>
                            </div>
                        }
                        else if (_chartXAxisLabels.Length == 0)
                        {
                            <div class="text-center py-12">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Secondary"
                                         Class="mb-2"/>
                                <MudText Typo="Typo.body1" Color="Color.Secondary">داده‌ای در این بازه تاریخی یافت
                                    نشد.
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <div class="chart-container py-2">
                                <MudChart ChartType="ChartType.Line"
                                          ChartSeries="_chartSeries"
                                          XAxisLabels="_chartXAxisLabels"
                                          Width="100%"
                                          Height="420px"
                                          ChartOptions="_chartOptions"/>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @if (_viewMode == DashboardViewMode.CardsOnly)
    {
        <MudGrid>
            <!-- جدول ۵ کالای پرفروش -->
            <MudItem xs="12" lg="6">
                <MudCard Elevation="2" Class="rounded-lg h-100">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.Star"/>
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">پرفروش‌ترین کالاها</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(_sortMode == TopSellingSortMode.ByQuantity ? "بیشترین تعداد فروش موفق ثبت‌شده" : "بیشترین مبلغ کل فروش ثبت‌شده")
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                <MudButton
                                    Variant="@(_sortMode == TopSellingSortMode.ByQuantity ? Variant.Filled : Variant.Outlined)"
                                    OnClick="@(() => ChangeSortModeAsync(TopSellingSortMode.ByQuantity))">
                                    تعداد
                                </MudButton>
                                <MudButton
                                    Variant="@(_sortMode == TopSellingSortMode.BySalesAmount ? Variant.Filled : Variant.Outlined)"
                                    OnClick="@(() => ChangeSortModeAsync(TopSellingSortMode.BySalesAmount))">
                                    مبلغ
                                </MudButton>
                            </MudButtonGroup>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <MudTable Items="_topSellingProducts" Hover="true" Elevation="0" Loading="_isLoading">
                            <HeaderContent>
                                <MudTh>نام کالا</MudTh>
                                <MudTh>برند</MudTh>
                                <MudTh Style="text-align: center;">تعداد فروش</MudTh>
                                <MudTh Style="text-align: left;">مبلغ کل فروش</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="نام کالا">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@context.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.InternalCode</MudText>
                                </MudTd>
                                <MudTd DataLabel="برند">@context.BrandName</MudTd>
                                <MudTd DataLabel="تعداد" Style="text-align: center;">
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">
                                        @context.TotalQuantitySold
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="مبلغ کل" Style="text-align: left;">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                                        @context.TotalSalesAmount.ToString("N0")
                                    </MudText>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">هنوز فاکتور فروش نهایی‌شده‌ای ثبت
                                        نشده است.
                                    </MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- جدول ۵ قلم با بحرانی‌ترین موجودی انبار -->
            <MudItem xs="12" lg="6">
                <MudCard Elevation="2" Class="rounded-lg h-100">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Warning" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.PriorityHigh"/>
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">اقلام نیازمند تأمین فوری</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">۵ قلم با کمترین سطح نسبت به آستانه
                                هشدار
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       EndIcon="@Icons.Material.Filled.ArrowBack"
                                       OnClick="@(() => NavigationManager.NavigateTo("/inventory/alerts"))">
                                کل (@_totalAlertsCount)
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <MudTable Items="_topAlerts" Hover="true" Elevation="0" Loading="_isLoading">
                            <HeaderContent>
                                <MudTh>نام کالا</MudTh>
                                <MudTh>انبار</MudTh>
                                <MudTh Style="text-align: center;">موجودی</MudTh>
                                <MudTh Style="text-align: center;">کسری</MudTh>
                                <MudTh Style="text-align: center;">تأمین</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="نام کالا">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@context.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.InternalCode</MudText>
                                </MudTd>
                                <MudTd DataLabel="انبار">@context.WarehouseName</MudTd>
                                <MudTd DataLabel="موجودی" Style="text-align: center;">
                                    @if (context.CurrentStock == 0)
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                                 Variant="Variant.Filled">
                                            ۰
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                                 Variant="Variant.Filled">@context.CurrentStock</MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="کسری" Style="text-align: center;">
                                    <MudText Typo="Typo.body2" Color="Color.Error" Class="font-weight-bold">
                                        +@context.Deficit
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="تأمین" Style="text-align: center;">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => NavigationManager.NavigateTo($"/purchases/create?productId={context.ProductId}"))"/>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Success">تمامی موجودی‌ها در سطح مطلوب هستند.
                                    </MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<style>
    .dashboard-card {
        height: 100%;
        transition: transform 0.18s ease-in-out, box-shadow 0.18s ease-in-out;
    }

    .dashboard-card:hover {
        transform: translateY(-3px);
    }
</style>

@code {

    private enum ChartPeriodMode
    {
        Daily,
        Monthly
    }

    private enum ChartMetricMode
    {
        Both,
        SalesOnly,
        ProfitOnly
    }

    private enum DashboardViewMode
    {
        CardsOnly,
        ChartOnly
    }

    private DashboardViewMode _viewMode = DashboardViewMode.CardsOnly;
    private DashboardSummaryDto _summary = new();
    private List<TopSellingProductDto> _topSellingProducts = new();
    private List<LowStockAlertDto> _topAlerts = new();
    private int _totalAlertsCount = 0;
    private int _outOfStockCount = 0;
    private bool _isLoading = true;
    private bool _isLoadingChart = false;
    private bool _chartDataLoaded = false;
    private TopSellingSortMode _sortMode = TopSellingSortMode.ByQuantity;
    private ChartPeriodMode _chartPeriod = ChartPeriodMode.Daily;
    private ChartMetricMode _metricMode = ChartMetricMode.Both;

    // متغیرهای فیلتر بازه تاریخ نمودار
    private DateTime? _chartFromDate;
    private DateTime? _chartToDate;
    private bool _isCustomDateFilter = false;

    private List<SalesSummaryReportDto> _currentRawReportData = new();
    private List<ChartSeries<double>> _chartSeries = new();
    private string[] _chartXAxisLabels = Array.Empty<string>();

    private ChartOptions _chartOptions = new()
    {
        ShowLegend = true,
        ChartPalette = new[] { "#1e88e5", "#43a047" } // آبی برای فروش، سبز برای سود
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        _isLoading = true;
        try
        {
            _summary = await ReportService.GetDashboardSummaryAsync();
            _topSellingProducts = await ReportService.GetTopSellingProductsAsync(5, _sortMode);

            _topAlerts = await ProductService.GetTopLowStockAlertsAsync(5);
            var allAlerts = await ProductService.GetLowStockAlertsAsync();
            _totalAlertsCount = allAlerts.Count;
            _outOfStockCount = allAlerts.Count(a => a.CurrentStock == 0);

            if (_viewMode == DashboardViewMode.ChartOnly)
            {
                await FetchAndBuildChartAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری اطلاعات داشبورد: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetViewModeAsync(DashboardViewMode mode)
    {
        _viewMode = mode;
        if (_viewMode == DashboardViewMode.ChartOnly && !_chartDataLoaded)
        {
            await FetchAndBuildChartAsync();
        }
    }

    private async Task FetchAndBuildChartAsync()
    {
        _isLoadingChart = true;
        try
        {
            var filter = new ReportFilterDto();

            if (_isCustomDateFilter)
            {
                filter.FromDate = _chartFromDate;
                filter.ToDate = _chartToDate?.Date.AddDays(1).AddTicks(-1); // تا پایان روز انتخاب‌شده
            }
            else
            {
                if (_chartPeriod == ChartPeriodMode.Daily)
                {
                    filter.FromDate = DateTime.UtcNow.AddDays(-30);
                }
            }

            if (_chartPeriod == ChartPeriodMode.Daily || _isCustomDateFilter)
            {
                var dailyData = await ReportService.GetDailySalesSummaryAsync(filter);
                _currentRawReportData = dailyData.OrderBy(x => x.Date).ToList();

                // برچسب روزهای شمسی
                _chartXAxisLabels = _currentRawReportData
                    .Select(x => x.PeriodTitle.Length >= 5 ? x.PeriodTitle.Substring(5) : x.PeriodTitle)
                    .ToArray();
            }
            else
            {
                var monthlyData = await ReportService.GetMonthlySalesSummaryAsync(filter);
                _currentRawReportData = monthlyData.OrderBy(x => x.Date).ToList();

                // برچسب ماه‌های شمسی
                _chartXAxisLabels = _currentRawReportData
                    .Select(x => x.PeriodTitle)
                    .ToArray();
            }

            BuildChartSeries();
            _chartDataLoaded = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری نمودار: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingChart = false;
        }
    }

    private async Task ApplyChartDateFilterAsync()
    {
        if (_chartFromDate.HasValue && _chartToDate.HasValue && _chartFromDate > _chartToDate)
        {
            Snackbar.Add("تاریخ شروع نمی‌تواند بعد از تاریخ پایان باشد.", Severity.Warning);
            return;
        }

        _isCustomDateFilter = _chartFromDate.HasValue || _chartToDate.HasValue;
        await FetchAndBuildChartAsync();
    }

    private async Task ResetChartDateFilterAsync()
    {
        _chartFromDate = null;
        _chartToDate = null;
        _isCustomDateFilter = false;
        await FetchAndBuildChartAsync();
    }

    private void BuildChartSeries()
    {
        var seriesList = new List<ChartSeries<double>>();
        var palette = new List<string>();

        var salesData = _currentRawReportData
            .Select(x => Math.Round((double)x.TotalSales / 1_000_000.0, 1))
            .ToArray();

        var profitData = _currentRawReportData
            .Select(x => Math.Round((double)x.TotalProfit / 1_000_000.0, 1))
            .ToArray();

        if (_metricMode == ChartMetricMode.Both)
        {
            seriesList.Add(new ChartSeries<double> { Name = "فروش (میلیون تومان)", Data = salesData });
            seriesList.Add(new ChartSeries<double> { Name = "سود محقق‌شده (میلیون تومان)", Data = profitData });
            palette.Add("#1e88e5");
            palette.Add("#43a047");
        }
        else if (_metricMode == ChartMetricMode.SalesOnly)
        {
            seriesList.Add(new ChartSeries<double> { Name = "فروش (میلیون تومان)", Data = salesData });
            palette.Add("#1e88e5");
        }
        else if (_metricMode == ChartMetricMode.ProfitOnly)
        {
            seriesList.Add(new ChartSeries<double> { Name = "سود محقق‌شده (میلیون تومان)", Data = profitData });
            palette.Add("#43a047");
        }

        _chartSeries = seriesList;
        _chartOptions.ChartPalette = palette.ToArray();
    }

    private async Task ChangePeriodModeAsync(ChartPeriodMode mode)
    {
        _chartPeriod = mode;
        _isCustomDateFilter = false;
        _chartFromDate = null;
        _chartToDate = null;
        await FetchAndBuildChartAsync();
    }

    private void ChangeMetricModeAsync(ChartMetricMode mode)
    {
        if (_metricMode == mode) return;
        _metricMode = mode;
        BuildChartSeries();
    }

    private async Task ChangeSortModeAsync(TopSellingSortMode mode)
    {
        if (_sortMode == mode) return;
        _sortMode = mode;

        _isLoading = true;
        try
        {
            _topSellingProducts = await ReportService.GetTopSellingProductsAsync(5, _sortMode);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در مرتب‌سازی پرفروش‌ها: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

}
