@page "/products/create"
@using AutoSpare.Application.Common.Interfaces
@using AutoSpare.Application.Products
@using AutoSpare.Application.Products.DTOs
@inject IProductService ProductService
@inject IFileStorageService FileStorageService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mb-10">
    <MudCard Elevation="3" Class="rounded-lg">
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart"/>
                </MudAvatar>
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">تعریف کالای جدید</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">مشخصات پایه، تصویر، قیمت‌گذاری و تنظیمات موجودی اولیه</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="GoBack">بازگشت</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudDivider/>

        <MudCardContent>
            @if (_isLoading)
            {
                <div class="d-flex justify-center my-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                </div>
            }
            else
            {
                <MudForm @ref="_form" @bind-IsValid="_isFormValid">
                    <MudGrid Spacing="3">
                        <!-- بخش آپلود تصویر کالا -->
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">تصویر کالا</MudText>
                            <div class="d-flex align-center gap-4 flex-wrap">
                                <div class="d-flex justify-center align-center rounded border border-dashed pa-2 mud-background-gray"
                                     style="width: 140px; height: 140px;">
                                    @if (!string.IsNullOrEmpty(_previewImageUrl))
                                    {
                                        <MudImage Src="@_previewImageUrl" Alt="پیش‌نمایش تصویر" ObjectFit="ObjectFit.Contain" Width="124" Height="124" Class="rounded" />
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column align-center text-muted">
                                            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default"/>
                                            <MudText Typo="Typo.caption" Class="mt-1">بدون تصویر</MudText>
                                        </div>
                                    }
                                </div>

                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex gap-2">
                                        <MudButton HtmlTag="label"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Secondary"
                                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                                   for="productImageInput">
                                            انتخاب تصویر
                                        </MudButton>
                                        <InputFile id="productImageInput" OnChange="OnImageSelected" accept=".jpg,.jpeg,.png,.webp" style="display:none;" />

                                        @if (_selectedImageFile != null)
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Error"
                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                       OnClick="RemoveSelectedImage">
                                                حذف
                                            </MudButton>
                                        }
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        فرمت‌های مجاز: JPG, PNG, WEBP (حداکثر حجم: ۳ مگابایت)
                                    </MudText>
                                    @if (_selectedImageFile != null)
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">
                                            @_selectedImageFile.Name (@((_selectedImageFile.Size / 1024.0 / 1024.0).ToString("F2")) MB)
                                        </MudChip>
                                    }
                                </div>
                            </div>
                        </MudItem>

                        <MudItem xs="12"><MudDivider Class="my-1"/></MudItem>

                        <!-- ردیف اول: نام کالا و مدل -->
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="نام قطعه / کالا"
                                          @bind-Value="_model.Name"
                                          Validation="@(new Func<string, string?>(ValidateName))"
                                          Immediate="true"
                                          Required="true"
                                          RequiredError="نام کالا الزامی است"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"/>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="مدل / تیپ خودرو"
                                          @bind-Value="_model.Model"
                                          HelperText="مثال: پراید صبا، پژو ۲۰۶ تیپ ۲"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"/>
                        </MudItem>

                        <!-- ردیف دوم: کد فنی -->
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="کد فنی / شناسه داخلی"
                                          @bind-Value="_model.InternalCode"
                                          Validation="@(new Func<string, string?>(ValidateInternalCode))"
                                          Immediate="true"
                                          Required="true"
                                          RequiredError="کد فنی الزامی است"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"/>
                        </MudItem>

                        <!-- ردیف سوم: دسته‌بندی و برند -->
                        <MudItem xs="12" md="6">
                            <MudSelect T="Guid?"
                                       Label="دسته‌بندی"
                                       @bind-Value="_model.CategoryId"
                                       Required="true"
                                       RequiredError="انتخاب دسته‌بندی الزامی است"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (var cat in _categories)
                                {
                                    <MudSelectItem Value="@((Guid?)cat.Id)">@cat.Title</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSelect T="Guid?"
                                       Label="برند سازنده"
                                       @bind-Value="_model.BrandId"
                                       Required="true"
                                       RequiredError="انتخاب برند الزامی است"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (var br in _brands)
                                {
                                    <MudSelectItem Value="@((Guid?)br.Id)">@br.Title</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- بخش قیمت‌ها -->
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mt-2">قیمت‌گذاری (تومان/ریال)</MudText>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal"
                                             Label="قیمت خرید"
                                             @bind-Value="_model.PurchasePrice"
                                             Validation="@(new Func<decimal, string?>(ValidatePurchasePrice))"
                                             Min="0"
                                             Format="N0"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"/>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal"
                                             Label="قیمت فروش"
                                             @bind-Value="_model.SalePrice"
                                             Validation="@(new Func<decimal, string?>(ValidateSalePrice))"
                                             Min="0"
                                             Format="N0"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"/>
                        </MudItem>

                        <!-- بخش انبار و موجودی -->
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mt-2">موجودی و انبار اولیه</MudText>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSelect T="Guid?"
                                       Label="انبار پیش‌فرض / اولیه"
                                       @bind-Value="_model.DefaultWarehouseId"
                                       Clearable="true"
                                       HelperText="در صورت ثبت موجودی اولیه، انبار الزامی است"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (var wh in _warehouses)
                                {
                                    <MudSelectItem Value="@((Guid?)wh.Id)">@wh.Title</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudNumericField T="int"
                                             Label="تعداد موجودی اولیه"
                                             @bind-Value="_model.InitialQuantity"
                                             Validation="@(new Func<int, string?>(ValidateInitialQuantity))"
                                             Min="0"
                                             Disabled="@(!_model.DefaultWarehouseId.HasValue)"
                                             HelperText="@(!_model.DefaultWarehouseId.HasValue ? "ابتدا انبار را مشخص کنید" : "این تعداد در کاردکس ثبت خواهد شد")"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"/>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            }
        </MudCardContent>

        <MudCardActions Class="pa-4 d-flex justify-end gap-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="GoBack"
                       Disabled="_isSubmitting">
                انصراف
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SubmitAsync"
                       Disabled="@(!_isFormValid || _isSubmitting)"
                       StartIcon="@Icons.Material.Filled.Save">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-2"/>
                    <span>در حال ذخیره...</span>
                }
                else
                {
                    <span>ثبت و ذخیره کالا</span>
                }
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isFormValid;
    private bool _isLoading = true;
    private bool _isSubmitting;

    private CreateProductDto _model = new();
    private List<DropdownItemDto> _categories = new();
    private List<DropdownItemDto> _brands = new();
    private List<DropdownItemDto> _warehouses = new();

    // متغیرهای مدیریت تصویر
    private IBrowserFile? _selectedImageFile;
    private string? _previewImageUrl;
    private const long MaxFileSize = 3 * 1024 * 1024; // ۳ مگابایت

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            _categories = await ProductService.GetCategoriesLookupAsync();
            _brands = await ProductService.GetBrandsLookupAsync();
            _warehouses = await ProductService.GetWarehousesLookupAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری اطلاعات اولیه: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > MaxFileSize)
        {
            Snackbar.Add("حجم فایل انتخابی بیش از ۳ مگابایت است.", Severity.Error);
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".jpg" && ext != ".jpeg" && ext != ".png" && ext != ".webp")
        {
            Snackbar.Add("فرمت فایل انتخابی مجاز نیست. فقط JPG, PNG یا WEBP انتخاب کنید.", Severity.Error);
            return;
        }

        try
        {
            _selectedImageFile = file;
            // ساخت تصویر پیش‌نمایش در مرورگر
            var resizedImage = await file.RequestImageFileAsync(file.ContentType, 300, 300);
            var buffer = new byte[resizedImage.Size];
            await resizedImage.OpenReadStream(MaxFileSize).ReadAsync(buffer);
            _previewImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در پیش‌نمایش تصویر: {ex.Message}", Severity.Warning);
        }
    }

    private void RemoveSelectedImage()
    {
        _selectedImageFile = null;
        _previewImageUrl = null;
    }

    private string? ValidateName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "نام کالا الزامی است.";
        if (name.Trim().Length < 3)
            return "نام کالا باید حداقل ۳ کاراکتر باشد.";
        if (name.Trim().Length > 200)
            return "نام کالا نمی‌تواند بیشتر از ۲۰۰ کاراکتر باشد.";
        return null;
    }

    private string? ValidateInternalCode(string code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return "کد فنی الزامی است.";
        if (code.Trim().Length < 2)
            return "کد فنی باید حداقل ۲ کاراکتر باشد.";
        if (code.Trim().Length > 50)
            return "کد فنی نمی‌تواند بیشتر از ۵۰ کاراکتر باشد.";
        return null;
    }

    private string? ValidatePurchasePrice(decimal purchasePrice)
    {
        if (purchasePrice < 0)
            return "قیمت خرید نمی‌تواند منفی باشد.";
        return null;
    }

    private string? ValidateSalePrice(decimal salePrice)
    {
        if (salePrice < 0)
            return "قیمت فروش نمی‌تواند منفی باشد.";
        if (salePrice < _model.PurchasePrice)
            return "قیمت فروش نمی‌تواند کمتر از قیمت خرید باشد.";
        return null;
    }

    private string? ValidateInitialQuantity(int qty)
    {
        if (qty < 0)
            return "تعداد موجودی اولیه نمی‌تواند منفی باشد.";
        return null;
    }

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        if (_model.InitialQuantity > 0 && !_model.DefaultWarehouseId.HasValue)
        {
            Snackbar.Add("برای ثبت موجودی اولیه، باید انبار را مشخص کنید.", Severity.Warning);
            return;
        }

        try
        {
            _isSubmitting = true;

            var isUnique = await ProductService.IsInternalCodeUniqueAsync(_model.InternalCode);
            if (!isUnique)
            {
                Snackbar.Add("کد فنی وارد شده تکراری است. لطفاً کد دیگری انتخاب کنید.", Severity.Warning);
                return;
            }

            // اگر تصویری انتخاب شده بود، ابتدا در سرور ذخیره می‌شود
            if (_selectedImageFile != null)
            {
                await using var stream = _selectedImageFile.OpenReadStream(MaxFileSize);
                _model.ImagePath = await FileStorageService.SaveProductImageAsync(stream, _selectedImageFile.Name);
            }

            await ProductService.CreateProductAsync(_model);
            Snackbar.Add("کالا با موفقیت ذخیره شد.", Severity.Success);
            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            // در صورت بروز خطا در ثبت محصول، اگر فایلی ذخیره شده بود حذف می‌کنیم تا فایل بی‌استفاده روی سرور نماند
            if (!string.IsNullOrEmpty(_model.ImagePath))
            {
                FileStorageService.DeleteFile(_model.ImagePath);
                _model.ImagePath = null;
            }
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/products");
    }
}
