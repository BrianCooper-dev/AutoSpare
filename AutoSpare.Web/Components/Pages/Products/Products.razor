@page "/products"

@using AutoSpare.Application.Products
@using AutoSpare.Application.Products.DTOs

@inject IProductService ProductService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">
    <MudCard Elevation="3" Class="rounded-lg">
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2"/>
                </MudAvatar>
            </CardHeaderAvatar>

            <CardHeaderContent>
                <MudText Typo="Typo.h6">مدیریت کالاها و قطعات</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    فهرست کلیه کالاها، وضعیت موجودی، قیمت و انبار پیش‌فرض
                </MudText>
            </CardHeaderContent>

            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => Navigation.NavigateTo("/products/create"))">
                    تعریف کالای جدید
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudDivider/>

        <MudCardContent>
            <!-- نوار فیلترهای پیشرفته -->
            <MudPaper Elevation="0" Class="pa-3 mb-4 rounded border mud-background-gray">
                <MudGrid Spacing="2" Class="align-center">
                    <!-- جستجوی متنی -->
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string"
                                      Value="@_filter.SearchTerm"
                                      ValueChanged="@(async (string val) =>
                                                    {
                                                        _filter.SearchTerm = val;
                                                        await LoadProductsAsync();
                                                    })"
                                      OnClearButtonClick="@(async () =>
                                                          {
                                                              _filter.SearchTerm = string.Empty;
                                                              await LoadProductsAsync();
                                                          })"
                                      Placeholder="نام، کد فنی، مدل یا برند..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Small"
                                      Clearable="true"
                                      DebounceInterval="400"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"/>
                    </MudItem>

                    <!-- دسته‌بندی -->
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="Guid?"
                                   Label="دسته‌بندی"
                                   Value="@_filter.CategoryId"
                                   ValueChanged="@(async (Guid? val) =>
                                                 {
                                                     _filter.CategoryId = val;
                                                     await LoadProductsAsync();
                                                 })"
                                   Clearable="true"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var cat in _categories)
                            {
                                <MudSelectItem Value="@((Guid?)cat.Id)">@cat.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- برند -->
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="Guid?"
                                   Label="برند"
                                   Value="@_filter.BrandId"
                                   ValueChanged="@(async (Guid? val) =>
                                                 {
                                                     _filter.BrandId = val;
                                                     await LoadProductsAsync();
                                                 })"
                                   Clearable="true"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var brand in _brands)
                            {
                                <MudSelectItem Value="@((Guid?)brand.Id)">@brand.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- انبار -->
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="Guid?"
                                   Label="انبار"
                                   Value="@_filter.WarehouseId"
                                   ValueChanged="@(async (Guid? val) =>
                                                 {
                                                     _filter.WarehouseId = val;
                                                     await LoadProductsAsync();
                                                 })"
                                   Clearable="true"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var wh in _warehouses)
                            {
                                <MudSelectItem Value="@((Guid?)wh.Id)">@wh.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- وضعیت موجودی -->
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="StockStatusFilter"
                                   Label="وضعیت موجودی"
                                   Value="@_filter.StockStatus"
                                   ValueChanged="@(async (StockStatusFilter val) =>
                                                 {
                                                     _filter.StockStatus = val;
                                                     await LoadProductsAsync();
                                                 })"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem Value="StockStatusFilter.All">همه</MudSelectItem>
                            <MudSelectItem Value="StockStatusFilter.InStock">موجود</MudSelectItem>
                            <MudSelectItem Value="StockStatusFilter.OutOfStock">ناموجود</MudSelectItem>
                            <MudSelectItem Value="StockStatusFilter.LowStock">کم‌موجودی (تا ۵ عدد)</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <!-- دکمه پاک کردن فیلترها -->
                    <MudItem xs="12" sm="6" md="1" Class="d-flex justify-center">
                        <MudTooltip Text="حذف همه فیلترها">
                            <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                                           Color="Color.Secondary"
                                           OnClick="ResetFiltersAsync"
                                           Disabled="@(!HasActiveFilters || _isLoading)"/>
                        </MudTooltip>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- جدول داده‌ها -->
            <MudTable Items="@_products"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Loading="@_isLoading"
                      LoadingProgressColor="Color.Primary"
                      Elevation="0">
                <HeaderContent>
                    <MudTh Style="width: 70px; text-align: center;">تصویر</MudTh>
                    <MudTh>نام قطعه</MudTh>
                    <MudTh>کد فنی</MudTh>
                    <MudTh>مدل / خودرو</MudTh>
                    <MudTh>دسته‌بندی</MudTh>
                    <MudTh>برند</MudTh>
                    <MudTh Style="text-align: left;">قیمت فروش (تومان)</MudTh>
                    <MudTh Style="text-align: center;">موجودی</MudTh>
                    <MudTh>انبار پیش‌فرض</MudTh>
                    <MudTh Style="text-align: center; width: 80px;">عملیات</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd Style="text-align: center;">
                        @if (!string.IsNullOrWhiteSpace(context.ImagePath))
                        {
                            <MudImage Src="@context.ImagePath"
                                      Alt="@context.Name"
                                      Width="45"
                                      Height="45"
                                      ObjectFit="ObjectFit.Cover"
                                      Class="rounded border"/>
                        }
                        else
                        {
                            <MudAvatar Size="Size.Medium" Variant="Variant.Outlined" Color="Color.Default">
                                <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Small"/>
                            </MudAvatar>
                        }
                    </MudTd>

                    <MudTd DataLabel="نام قطعه">
                        <MudText Typo="Typo.body2" Class="fw-bold">@context.Name</MudText>
                    </MudTd>

                    <MudTd DataLabel="کد فنی">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Dark">
                            @context.InternalCode
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="مدل">
                        @(string.IsNullOrWhiteSpace(context.Model) ? "-" : context.Model)
                    </MudTd>

                    <MudTd DataLabel="دسته‌بندی">
                        @context.CategoryName
                    </MudTd>

                    <MudTd DataLabel="برند">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                            @context.BrandName
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="قیمت فروش" Style="text-align: left;">
                        <MudText Typo="Typo.body2" Color="Color.Success" Class="fw-bold">
                            @context.SalePrice.ToString("N0")
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="موجودی" Style="text-align: center;">
                        @if (context.TotalStock > 5)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                @context.TotalStock عدد
                            </MudChip>
                        }
                        else if (context.TotalStock > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                @context.TotalStock عدد (کم)
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                ناموجود
                            </MudChip>
                        }
                    </MudTd>

                    <MudTd DataLabel="انبار پیش‌فرض">
                        @(context.DefaultWarehouseName ?? "-")
                    </MudTd>

                    <MudTd DataLabel="عملیات" Style="text-align: center;">
                        <MudTooltip Text="مشاهده جزئیات و کاردکس">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => Navigation.NavigateTo($"/products/{context.Id}"))" />
                        </MudTooltip>
                    </MudTd>

                </RowTemplate>

                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6 text-muted">
                        هیچ کالایی با فیلترهای انتخابی یافت نشد.
                    </MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager RowsPerPageString="تعداد در هر صفحه:"
                                   InfoFormat="{first_item}-{last_item} از {all_items}"/>
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<ProductListItemDto> _products = new();
    private ProductFilterDto _filter = new();
    private bool _isLoading = true;

    private List<DropdownItemDto> _categories = new();
    private List<DropdownItemDto> _brands = new();
    private List<DropdownItemDto> _warehouses = new();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_filter.SearchTerm) ||
        _filter.CategoryId.HasValue ||
        _filter.BrandId.HasValue ||
        _filter.WarehouseId.HasValue ||
        _filter.StockStatus != StockStatusFilter.All;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            // واکشی ترتیبی اطلاعات لوک‌آپ برای جلوگیری از تداخل عملیات در یک DbContext
            _categories = await ProductService.GetCategoriesLookupAsync();
            _brands = await ProductService.GetBrandsLookupAsync();
            _warehouses = await ProductService.GetWarehousesLookupAsync();

            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری اطلاعات اولیه: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            _isLoading = true;
            _products = await ProductService.GetProductsAsync(_filter);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری فهرست کالاها: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResetFiltersAsync()
    {
        _filter = new ProductFilterDto();
        await LoadProductsAsync();
    }
}

