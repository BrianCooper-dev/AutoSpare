@page "/sales/print-receipt/{Id:guid}"

@using AutoSpare.Application.Common.Settings
@using AutoSpare.Application.Sales
@using AutoSpare.Application.Sales.DTOs
@using Microsoft.Extensions.Options

@inject ISaleService SaleService
@inject IOptions<StoreSettings> StoreSettingsOptions
@inject IJSRuntime Js

<PageTitle>چاپ فیش حرارتی @(_sale?.InvoiceNumber ?? string.Empty)</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="thermal-root rtl">

    @if (_isLoading)
    {
        <MudPaper Elevation="1" Class="pa-6 d-flex flex-column align-center justify-center mt-6 thermal-shell">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" Class="mb-4"/>
            <MudText Typo="Typo.body2">در حال بارگذاری اطلاعات فیش...</MudText>
        </MudPaper>
    }
    else if (_sale is null)
    {
        <MudPaper Elevation="1" Class="pa-6 mt-6 thermal-shell">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                فاکتور مورد نظر یافت نشد.
            </MudAlert>

            <div class="mt-4 d-flex justify-center">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="ClosePage">
                    بستن صفحه
                </MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        @* Action Bar (در چاپ مخفی می‌شود) *@
        <MudPaper Elevation="1" Class="no-print pa-3 mb-3 thermal-shell">
            <div class="d-flex flex-wrap gap-2 justify-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="TriggerPrint">
                    چاپ فیش
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="ClosePage">
                    بستن صفحه
                </MudButton>
            </div>
        </MudPaper>

        <div class="receipt-sheet">
            <div class="text-center mb-2">
                <h3 class="store-title">@_store.StoreName</h3>
                @if (!string.IsNullOrWhiteSpace(_store.Address))
                {
                    <p class="store-info">@_store.Address</p>
                }
                @if (!string.IsNullOrWhiteSpace(_store.Phone))
                {
                    <p class="store-info">تلفن: @_store.Phone</p>
                }
            </div>

            <div class="divider">--------------------------------------------------</div>

            <div class="invoice-meta">
                <div class="row-line">
                    <span>شماره فاکتور:</span>
                    <strong class="dir-ltr">@_sale.InvoiceNumber</strong>
                </div>
                <div class="row-line">
                    <span>تاریخ:</span>
                    <span>@_sale.SaleDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                </div>
                <div class="row-line">
                    <span>مشتری:</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(_sale.CustomerName) ? "مشتری متفرقه" : _sale.CustomerName)
                    </strong>
                </div>
                <div class="row-line">
                    <span>وضعیت:</span>
                    <span>@_sale.Status</span>
                </div>
            </div>

            <div class="divider">--------------------------------------------------</div>

            <table class="receipt-table">
                <thead>
                <tr>
                    <th style="text-align:right;">شرح کالا</th>
                    <th style="text-align:center; width:35px;">تعداد</th>
                    <th style="text-align:left;">مبلغ کل</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in _sale.Items)
                {
                    <tr>
                        <td colspan="3" class="product-name">@item.ProductName</td>
                    </tr>
                    <tr>
                        <td class="product-code">کد: @item.ProductCode</td>
                        <td style="text-align:center;">@item.Quantity</td>
                        <td style="text-align:left;" class="dir-ltr">@item.TotalPrice.ToString("N0")</td>
                    </tr>
                    <tr class="item-sep">
                        <td colspan="3"></td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="divider">--------------------------------------------------</div>

            <div class="financial-summary">
                <div class="row-line total-row">
                    <span>مبلغ قابل پرداخت:</span>
                    <span class="dir-ltr"><strong>@_sale.TotalAmount.ToString("N0") تومان</strong></span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_sale.Notes))
            {
                <div class="divider">--------------------------------------------------</div>
                <div class="receipt-notes">
                    <small><strong>یادداشت:</strong> @_sale.Notes</small>
                </div>
            }

            <div class="divider">--------------------------------------------------</div>

            <div class="text-center footer-text">
                @if (!string.IsNullOrWhiteSpace(_store.FooterNote))
                {
                    <p>@_store.FooterNote</p>
                }
                else
                {
                    <p>اجناس فروخته شده در صورت باز نشدن پلمپ تا ۴۸ ساعت قابل تعویض می‌باشد.</p>
                    <p class="mt-1">از خرید شما سپاسگزاریم</p>
                }
            </div>
        </div>
    }
</MudContainer>

<style>
    .thermal-root {
        min-height: 100vh;
        padding: 16px;
        background-color: #eee;
        font-family: Sahel, Vazirmatn, Tahoma, Arial, sans-serif;
        direction: rtl;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #000;
    }

    .thermal-shell {
        width: 80mm;
        max-width: calc(100vw - 24px);
        margin-left: auto;
        margin-right: auto;
    }

    .receipt-sheet {
        width: 80mm;
        max-width: calc(100vw - 24px);
        background: #fff;
        padding: 4mm;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.10);
        font-size: 11px;
        line-height: 1.4;
    }

    .store-title {
        font-size: 14px;
        font-weight: bold;
        margin: 0 0 4px;
    }

    .store-info {
        font-size: 10px;
        margin: 2px 0;
        color: #333;
    }

    .divider {
        text-align: center;
        font-family: monospace;
        letter-spacing: -1px;
        color: #666;
        margin: 6px 0;
        font-size: 10px;
    }

    .invoice-meta {
        font-size: 11px;
    }

    .row-line {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .receipt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

    .receipt-table th {
        font-size: 10px;
        border-bottom: 1px dashed #000;
        padding-bottom: 3px;
    }

    .product-name {
        font-weight: bold;
        padding-top: 4px;
    }

    .product-code {
        font-size: 9px;
        color: #555;
    }

    .item-sep td {
        border-bottom: 1px dotted #ddd;
        height: 4px;
    }

    .total-row {
        font-size: 13px;
        font-weight: bold;
        margin: 6px 0;
    }

    .footer-text {
        font-size: 9px;
        color: #444;
        margin-top: 8px;
    }

    .dir-ltr {
        direction: ltr;
        display: inline-block;
    }

    @@media print {
        body {
            background: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .no-print {
            display: none !important;
        }

        .thermal-root {
            background: none !important;
            padding: 0 !important;
        }

        .receipt-sheet {
            width: 80mm !important;
            box-shadow: none !important;
            margin: 0 !important;
            padding: 2mm !important;
        }
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }

    private SaleDetailsDto? _sale;
    private StoreSettings _store = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _store = StoreSettingsOptions.Value;

        try
        {
            _sale = await SaleService.GetSaleDetailsAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task TriggerPrint()
    {
        await Js.InvokeVoidAsync("window.print");
    }

    private async Task ClosePage()
    {
        await Js.InvokeVoidAsync("window.close");
    }

}

